---
import { existsSync } from "node:fs";
import Header from "../components/sections/header/header.astro";
import SmoothScroll from "../components/common/smooth-scroll.astro";
import "modern-normalize/modern-normalize.css";
import "../styles/index.css";
import "../styles/lenis.css";
import { getTranslations, defaultLocale } from "../i18n/utils";
import designs, { defaultDesignId } from "../designs";

const designIds = designs.map((design) => design.id);
const preloadFontsByDesign = Object.fromEntries(
  designs.map((design) => [design.id, design.preloadFonts]),
);
const themeColorsByDesign = Object.fromEntries(
  designs.map((design) => [design.id, design.themeColor]),
);
const defaultThemeColor = themeColorsByDesign[defaultDesignId].light;

const lang = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(lang);

const hasSocialImage = existsSync("public/og.png");

const seo = {
  title: t("seo.title"),
  description: t("seo.description"),
  keywords: t("seo.keywords"),
  url: "https://angelozdev.com",
  image: "/og.png",
  author: "Angelo Zambrano",
};

const year = new Date().getFullYear();

const ogLocale = lang === "es" ? "es_CO" : "en_US";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Angelo Zambrano",
  url: seo.url,
  ...(hasSocialImage ? { image: `${seo.url}${seo.image}` } : {}),
  jobTitle: "Software Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Ubidots",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Medellín",
    addressCountry: "Colombia",
  },
  sameAs: [
    "https://www.linkedin.com/in/angelozdev/",
    "https://github.com/angelozdev",
  ],
  knowsAbout: [
    "TypeScript",
    "React",
    "React Native",
    "Design Systems",
    "Accessibility",
    "Python",
    "FastAPI",
    "Model Context Protocol",
    "LLM application development",
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="light" data-design={defaultDesignId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={defaultThemeColor} />

    <!-- Theme initialization script (must run before CSS to prevent FOUC) -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = "theme-preference";
        const THEME_ATTRIBUTE = "data-theme";

        function getSystemPreference() {
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        function getStoredTheme() {
          try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored === "light" || stored === "dark") {
              return stored;
            }
            return null;
          } catch (e) {
            return null;
          }
        }

        function getResolvedTheme() {
          const stored = getStoredTheme();
          if (stored === "light" || stored === "dark") {
            return stored;
          }
          return getSystemPreference();
        }

        const theme = getResolvedTheme();
        document.documentElement.setAttribute(THEME_ATTRIBUTE, theme);
      })();
    </script>

    <script
      is:inline
      define:vars={{
        designIds,
        defaultDesignId,
        preloadFontsByDesign,
        themeColorsByDesign,
      }}
    >
      (function () {
        const STORAGE_KEY = "design-preference";

        function getStoredDesign() {
          try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw === null) return null;
            const parsed = JSON.parse(raw);
            return designIds.includes(parsed) ? parsed : null;
          } catch (e) {
            return null;
          }
        }

        const design = getStoredDesign() || defaultDesignId;
        document.documentElement.setAttribute("data-design", design);

        window.__designThemeColors = themeColorsByDesign;
        const theme = document.documentElement.getAttribute("data-theme");
        const palette = themeColorsByDesign[design];
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && palette) {
          meta.setAttribute(
            "content",
            theme === "dark" ? palette.dark : palette.light,
          );
        }

        for (const href of preloadFontsByDesign[design] || []) {
          const link = document.createElement("link");
          link.rel = "preload";
          link.as = "font";
          link.type = "font/woff2";
          link.href = href;
          link.crossOrigin = "anonymous";
          document.head.appendChild(link);
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{seo.title}</title>
    <meta name="title" content={seo.title} />
    <meta name="description" content={seo.description} />
    <meta name="author" content={seo.author} />
    <meta name="keywords" content={seo.keywords} />
    <link rel="canonical" href={`${seo.url}${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="en" href={`${seo.url}/`} />
    <link rel="alternate" hreflang="es" href={`${seo.url}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${seo.url}/`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${seo.url}${Astro.url.pathname}`} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {
      hasSocialImage && (
        <meta property="og:image" content={`${seo.url}${seo.image}`} />
      )
    }
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={hasSocialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:url" content={`${seo.url}${Astro.url.pathname}`} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {
      hasSocialImage && (
        <meta name="twitter:image" content={`${seo.url}${seo.image}`} />
      )
    }

    <!-- Structured Data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("a11y.skipToContent")}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <p class="footer__line">© {year} Angelo Zambrano</p>
    </footer>
    <SmoothScroll />
  </body>

  <style>
    .footer {
      padding: var(--space-8) var(--space-4);
      border-top: var(--border-width) solid var(--color-border);
    }

    .footer__line {
      max-width: var(--breakpoint-xl);
      margin: var(--space-0) auto;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }
  </style>
</html>

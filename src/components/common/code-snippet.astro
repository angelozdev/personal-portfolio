---
import Badge from "./badge.astro";
import { defaultLocale, getTranslations } from "../../i18n/utils";

interface Props {
  code: string;
  language?: string;
}

const { code, language } = Astro.props;

const t = getTranslations(Astro.currentLocale ?? defaultLocale);
const label = language
  ? `${t("a11y.codeSample")} — ${language}`
  : t("a11y.codeSample");
---

<div class="code-snippet">
  {
    language && (
      <div class="code-snippet__bar">
        <Badge>{language}</Badge>
      </div>
    )
  }
  <pre class="code-snippet__pre" tabindex="0" role="region" aria-label={label}><code
    >{code}</code></pre>
</div>

<style>
  .code-snippet {
    min-width: 0;
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .code-snippet__bar {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .code-snippet__pre {
    margin: var(--space-0);
    padding: var(--space-4);
    overflow-x: auto;
  }

  .code-snippet__pre code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }
</style>

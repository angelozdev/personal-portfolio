---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li"> {
	label?: string;
	marker?: "dot" | "none";
}

const { label, marker = "dot", class: className, ...rest } = Astro.props;
---

<li class:list={["timeline-item", className]} {...rest}>
	<div class="timeline-item__label">
		<slot name="label">{label}</slot>
	</div>

	<div class="timeline-item__body">
		{marker === "dot" && <span class="timeline-item__marker" aria-hidden="true" />}
		<slot />
	</div>
</li>

<style>
	.timeline-item {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		column-gap: var(--timeline-gap, var(--space-6));
	}

	.timeline-item__label {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.timeline-item__body {
		position: relative;
		border-left: 1px solid var(--timeline-rail-color, var(--color-border));
		padding-left: var(--timeline-gap, var(--space-6));
		padding-bottom: var(--timeline-spacing, var(--space-10));
	}

	.timeline-item:last-child .timeline-item__body {
		padding-bottom: var(--space-0);
	}

	.timeline-item__marker {
		position: absolute;
		top: var(--timeline-marker-top, 0.5rem);
		left: calc(var(--timeline-marker-size, 0.5rem) / -2 - 0.5px);
		width: var(--timeline-marker-size, 0.5rem);
		height: var(--timeline-marker-size, 0.5rem);
		border-radius: var(--radius-full);
		background-color: var(--timeline-marker-color, var(--color-text-muted));
	}

	@media (max-width: 640px) {
		.timeline-item {
			position: relative;
			grid-template-columns: 1fr;
			row-gap: var(--space-1);
			padding-left: var(--timeline-gap, var(--space-6));
		}

		.timeline-item::before {
			content: "";
			position: absolute;
			inset-block: 0;
			left: 0;
			width: 1px;
			background-color: var(--timeline-rail-color, var(--color-border));
		}

		.timeline-item__body {
			position: static;
			border-left: none;
			padding-left: var(--space-0);
		}

		.timeline-item__marker {
			top: calc(var(--text-sm) * var(--leading-normal) / 2);
			left: calc(var(--timeline-marker-size, 0.5rem) / -2);
			transform: translateY(-50%);
		}
	}
</style>

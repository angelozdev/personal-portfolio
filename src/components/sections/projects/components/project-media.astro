---
import { Image } from "astro:assets";
import CodeSnippet from "../../../common/code-snippet.astro";
import type { ProjectMedia } from "../get-projects-data";

interface Props {
  media: ProjectMedia;
}

const { media } = Astro.props;
---

{
  media.type === "image" ? (
    <div class="project-media project-media--image">
      <Image
        src={media.src}
        alt={media.alt}
        class="project-media__image"
        loading="lazy"
        widths={[400, 800, media.src.width]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  ) : (
    <div class="project-media project-media--code">
      <CodeSnippet code={media.snippet} language={media.language} />
    </div>
  )
}

<style>
  .project-media--image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .project-media__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.3s ease;
  }

  .project-media--code {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    padding: var(--space-6);
    background-color: var(--color-bg);
  }

  @container (min-width: 640px) {
    .project-media--image {
      aspect-ratio: auto;
      height: 100%;
    }
  }
</style>

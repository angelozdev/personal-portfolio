---
import type { ExperienceEntry } from "../get-experience-data";

interface Props {
	entry: ExperienceEntry;
}

const { entry } = Astro.props;
---

<article class="experience-entry">
	<div class="experience-entry__identity">
		<header class="experience-entry__header">
			<h3 class="experience-entry__role">{entry.role}</h3>
			{entry.badge && <span class="experience-entry__badge">{entry.badge}</span>}
		</header>
		<p class="experience-entry__meta">
			<span class="experience-entry__company">{entry.company}</span>
			<span class="experience-entry__separator" aria-hidden="true">·</span>
			<span class="experience-entry__location">{entry.location}</span>
		</p>
	</div>

	<ul class="experience-entry__highlights">
		{
			entry.highlights.map((highlight) => (
				<li class="experience-entry__highlight">{highlight}</li>
			))
		}
	</ul>
</article>

<style>
	.experience-entry {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.experience-entry__identity {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.experience-entry__header {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.experience-entry__role {
		font-size: var(--text-lg);
		font-weight: var(--font-bold);
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: var(--space-0);
	}

	.experience-entry__badge {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		white-space: nowrap;
	}

	.experience-entry__meta {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: var(--space-0);
	}

	.experience-entry__company {
		font-weight: var(--font-medium);
		color: var(--color-text);
	}

	.experience-entry__separator {
		color: var(--color-border-hover);
	}

	.experience-entry__highlights {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: var(--space-0);
		padding-left: var(--space-0);
		list-style: none;
	}

	.experience-entry__highlight {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-3);
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
	}

	.experience-entry__highlight::before {
		content: "+";
		font-family: var(--font-mono);
		font-weight: var(--font-medium);
		color: var(--color-success);
	}
</style>
